# Justfile for Conv2D testbench

# Common Verilator flags
VFLAGS := "--binary --timing --quiet"
VFLAGS_TRACE := "--binary --timing --trace --quiet"
VFLAGS_LINT := "-Wall --lint-only"
SOURCES := "conv2d_tb.sv valid-hold.sv"

# Default target
default: build

# Build the testbench with Verilator
build:
    verilator {{VFLAGS}} -o sim {{SOURCES}}

# Build with VCD tracing support
build-trace:
    verilator {{VFLAGS_TRACE}} -o sim {{SOURCES}}

# Lint the files
lint:
    verilator {{VFLAGS_LINT}} {{SOURCES}}

# Run the simulation
run: build
    ./obj_dir/sim

# Run with VCD tracing
run-trace: build-trace
    ./obj_dir/sim

# Clean build artifacts
clean:
    rm -rf obj_dir *.vcd tests/*_n*.sv tests/*_d*_n*.sv pyramid_impl_n*.sv

# Test AetherlingConv directly with different N values
test-aetherling N:
    @echo "Testing AetherlingConv with N={{N}}"
    @if [ ! -f conv/{{N}}.sv ]; then echo "Error: conv/{{N}}.sv not found"; exit 1; fi
    sed 's/parameter N = 4;/parameter N = {{N}};/' tests/aetherling_tb.sv > tests/aetherling_tb_n{{N}}.sv
    verilator {{VFLAGS_TRACE}} -o sim_aetherling_n{{N}} tests/aetherling_tb_n{{N}}.sv conv/{{N}}.sv
    ./obj_dir/sim_aetherling_n{{N}}
    @[ -f aetherling_tb.vcd ] && mv aetherling_tb.vcd aetherling_tb_n{{N}}.vcd || true
    rm tests/aetherling_tb_n{{N}}.sv

# Test with different N values (with VCD tracing)
# Test a specific N value with custom name
test-n N:
    @echo "Testing Conv2D with N={{N}}"
    # @if [ ! -f conv/{{N}}.sv ]; then echo "Error: conv/{{N}}.sv not found"; exit 1; fi
    sed 's/parameter N = 4;/parameter N = {{N}};/' tests/conv2d_tb.sv > tests/conv2d_tb_n{{N}}.sv
    cat pyramid-dummy.sv > tests/conv2d_impl_n{{N}}.sv
    verilator {{VFLAGS_TRACE}} -o sim_n{{N}} tests/conv2d_tb_n{{N}}.sv tests/conv2d_impl_n{{N}}.sv
    ./obj_dir/sim_n{{N}}
    @[ -f conv2d_tb.vcd ] && mv conv2d_tb.vcd conv2d_tb_n{{N}}.vcd || true
    rm tests/conv2d_tb_n{{N}}.sv tests/conv2d_impl_n{{N}}.sv

# Test Blur module with specific D and N values
test-blur D N:
    @echo "Testing Blur with D={{D}}, N={{N}}"
    @if [ {{D}} -lt 4 ]; then echo "Error: D must be >= 4"; exit 1; fi
    sed 's/parameter D = 8;/parameter D = {{D}};/' tests/blur_tb.sv > tests/blur_tb_d{{D}}_n{{N}}.sv
    sed -i '' 's/parameter N = 4;/parameter N = {{N}};/' tests/blur_tb_d{{D}}_n{{N}}.sv
    verilator {{VFLAGS_TRACE}} -o sim_blur_d{{D}}_n{{N}} tests/blur_tb_d{{D}}_n{{N}}.sv pyramid-dummy.sv
    ./obj_dir/sim_blur_d{{D}}_n{{N}}
    @[ -f blur_tb.vcd ] && mv blur_tb.vcd blur_tb_d{{D}}_n{{N}}.vcd || true
    rm tests/blur_tb_d{{D}}_n{{N}}.sv

# Quick blur test with default parameters
test-blur-default: (test-blur "8" "4")

# Test Pyramid module with three N parameters (using gen-pyramid-tb.sh script)
test-pyramid Blur0_N Blur1_N BlurUp_N:
    @echo "Testing Pyramid with Blur0_N={{Blur0_N}}, Blur1_N={{Blur1_N}}, BlurUp_N={{BlurUp_N}}"
    ./gen-pyramid-tb.sh {{Blur0_N}} {{Blur1_N}} {{BlurUp_N}} testbench > tests/pyramid_tb_n{{Blur0_N}}.sv
    ./gen-pyramid-tb.sh {{Blur0_N}} {{Blur1_N}} {{BlurUp_N}} implementation > pyramid_impl_n{{Blur0_N}}.sv
    verilator {{VFLAGS_TRACE}} -o sim_pyramid_n{{Blur0_N}} tests/pyramid_tb_n{{Blur0_N}}.sv pyramid_impl_n{{Blur0_N}}.sv
    ./obj_dir/sim_pyramid_n{{Blur0_N}}
    @[ -f pyramid_tb.vcd ] && mv pyramid_tb.vcd pyramid_tb_n{{Blur0_N}}.vcd || true
    rm tests/pyramid_tb_n{{Blur0_N}}.sv pyramid_impl_n{{Blur0_N}}.sv

# Test pyramid testbench only (without implementation generation)
test-pyramid-tb Blur0_N Blur1_N BlurUp_N:
    @echo "Testing Pyramid testbench with Blur0_N={{Blur0_N}}, Blur1_N={{Blur1_N}}, BlurUp_N={{BlurUp_N}}"
    ./gen-pyramid-tb.sh {{Blur0_N}} {{Blur1_N}} {{BlurUp_N}} testbench > tests/pyramid_tb_n{{Blur0_N}}.sv
    verilator {{VFLAGS_TRACE}} -o sim_pyramid_tb_n{{Blur0_N}} tests/pyramid_tb_n{{Blur0_N}}.sv valid-hold.sv
    ./obj_dir/sim_pyramid_tb_n{{Blur0_N}}
    @[ -f pyramid_tb.vcd ] && mv pyramid_tb.vcd pyramid_tb_n{{Blur0_N}}.vcd || true
    rm tests/pyramid_tb_n{{Blur0_N}}.sv

# Generate implementation file only (no testing)
gen-pyramid-impl Blur0_N Blur1_N BlurUp_N:
    ./gen-pyramid-tb.sh {{Blur0_N}} {{Blur1_N}} {{BlurUp_N}} implementation

# Quick pyramid tests
test-pyramid-default: (test-pyramid "16" "16" "16")
test-pyramid-fast: (test-pyramid "4" "4" "4")
